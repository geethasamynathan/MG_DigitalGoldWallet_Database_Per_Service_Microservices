{
  "ReverseProxy": {
    "Routes": {
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/customer/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/customer"
          }
        ]
      },
      "vendor-route": {
        "ClusterId": "vendor-cluster",
        "Match": {
          "Path": "/vendor/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/vendor"
          }
        ]
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "Match": {
          "Path": "/wallet/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/wallet"
          }
        ]
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "Match": {
          "Path": "/transaction/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/transaction"
          }
        ]
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "https://localhost:7001/"
          }
        }
      },
      "vendor-cluster": {
        "Destinations": {
          "vendor-service": {
            "Address": "https://localhost:7002/"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-service": {
            "Address": "https://localhost:7003/"
          }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "transaction-service": {
            "Address": "https://localhost:7004/"
          }
        }
      }
    }
  }
}